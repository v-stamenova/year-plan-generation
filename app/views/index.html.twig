{% extends "partials/base.html.twig" %}

{% set pageTitle = "Home" %}

{% block content %}
    <link rel="stylesheet" href="/css/plan.css">
    <div class="container text-center">
        <h3>Year schedule ICT - first year 2026/2027</h3>

        <div class="row">
            <div class="col-1 border">Week</div>
            <div class="col-1 border">Block Week</div>
            <div class="col-1 border">Sunday</div>
            <div class="col border">Monday</div>
            <div class="col border">Tuesday</div>
            <div class="col border">Wednesday</div>
            <div class="col border">Thursday</div>
            <div class="col border">Friday</div>
            <div class="col-1 border">Saturday</div>
        </div>

        <div class="row">
            <div class="col-1 border schedule-cell">37</div>
            <div class="col-1 border schedule-cell">B2</div>

            {% for date, day in week %}
                {% if loop.first or loop.last %}
                    <div class="col-1 border schedule-cell">
                        {{ date }}
                    </div>
                {% else %}
                    <div class="col border schedule-cell" style="background-color: {{ day[0].colour }}">
                        {{ day is not empty ? (day[0].name ?: day[0].id) : '' }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
{% endblock %}