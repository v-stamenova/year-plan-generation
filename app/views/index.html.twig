{% extends "partials/base.html.twig" %}

{% set pageTitle = "Home" %}

{% block content %}
    {% include 'components/schedule_context_menu.html.twig'  with {
        courses: courses
    } %}
    <link rel="stylesheet" href="/css/plan.css">
    <script src="/js/schedule_context_menu.js"></script>

    <div class="container text-center">
        <h3>Year schedule ICT - first year 2026/2027</h3>
        <br>
        <div class="schedule-grid schedule-header">
            <div class="border">Week</div>
            <div class="border">Block Week</div>
            <div class="border">Sunday</div>
            <div class="border">Monday</div>
            <div class="border">Tuesday</div>
            <div class="border">Wednesday</div>
            <div class="border">Thursday</div>
            <div class="border">Friday</div>
            <div class="border">Saturday</div>
        </div>

        {% for key, week in weeks %}
            <div class="schedule-week">

                <div class="schedule-multiday-row">
                    {% for segment in week.multiDayItems %}
                        <div
                                class="schedule-multiday-item"
                                style="
                                        --start-column: {{ segment.startColumn }};
                                        --span: {{ segment.span }};
                                        background-color: {{ segment.item.colour }};
                                        "
                        >
                            {{ segment.item.name ?: segment.item.id }}
                        </div>
                    {% endfor %}
                </div>

                <div class="schedule-cell schedule-week-number">
                    {{ key }}
                </div>

                <div class="schedule-cell schedule-block-week">
                    B2
                </div>

                {% for date, day in week.days %}
                    <div class="schedule-cell schedule-day schedule-day-{{ loop.index }}{% if loop.first or loop.last %} schedule-edge-day{% endif %}"
                         data-date="{{ date|date('Y-m-d') }}"
                    >
                        {% if loop.first or loop.last %}
                            {{ date }}
                        {% else %}
                            {% include 'components/schedule_day.html.twig' with {
                                day: day
                            } %}
                        {% endif %}
                    </div>
                {% endfor %}

            </div>
        {% endfor %}
    </div>
{% endblock %}