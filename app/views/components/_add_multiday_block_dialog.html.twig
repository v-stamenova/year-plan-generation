<dialog class="dialog" id="addMultidayBlock">
    <div class="dialog-header">
        <h1 class="dialog-title">
            Add a new multi-day block
        </h1>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="dialog"
                aria-label="Close">
        </button>
    </div>

    <div class="dialog-body">
        <form id="addMultidayBlockForm"
              method="POST"
              action="{{ baseUrl|default('') }}"
              hx-post="{{ baseUrl|default('') }}"
              hx-target="#calendar">

            <input type="hidden"
                   name="is_one_time"
                   value="1">

            <div class="mb-3">
                <label class="form-label" for="multiDayEventName">
                    Name
                </label>

                <input type="text"
                       class="form-control"
                       id="multiDayEventName"
                       name="name"
                       placeholder="Enter event name"
                       required>
            </div>

            <div class="mb-3">
                <label class="form-label" for="multiBlockDate">
                    Start date
                </label>

                <input type="date"
                       id="multiBlockDate"
                       class="form-control"
                       name="start_date"
                       required>
            </div>

            <div class="mb-3">
                <label class="form-label" for="multiBlockEndDate">
                    End date
                </label>

                <input type="date"
                       class="form-control"
                       id="multiBlockEndDate"
                       name="end_date"
                       required>
            </div>

            <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between w-100">
                    <label class="form-label" for="check">
                        All-day event?
                    </label>
                    <input type="checkbox" id="check" name="allDay" class="check" />
                </div>
                <div class="form-text mb-2">
                    Distinguishes full-day events, such as school breaks, from markers
                    that simply indicate important dates or periods, such as the start
                    of a block or exam week.
                </div>
            </div>

            <div class="mb-3 d-flex align-items-center justify-content-between">
                <label class="form-label mb-0" for="multiDayColour">
                    Event colour
                </label>

                <input type="color"
                       class="form-control form-control-color"
                       id="multiDayColour"
                       name="colour"
                       value="#3788d8"
                       title="Choose event colour">
            </div>

            <div class="dialog-footer">
                <button type="button"
                        class="btn-solid theme-secondary"
                        data-bs-dismiss="dialog">
                    Cancel
                </button>

                <button type="submit"
                        class="btn-solid theme-primary">
                    Save
                </button>
            </div>
        </form>
    </div>
</dialog>