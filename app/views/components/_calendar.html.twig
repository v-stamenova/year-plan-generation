{% for key, week in weeks %}
    <div class="schedule-week">

        <div class="schedule-multiday-row">
            {% for segment in week.multiDaySegments %}
                {% if not segment.item.is_main %}
                    <div
                            class="schedule-multiday-item scheduled-block"
                            data-date="{{ segment.item.start_date | date("Y-m-d") }}"
                            data-menu="block"
                            id="{{ segment.item.id }}"
                            style="
                                    --start-column: {{ segment.startColumn }};
                                    --span: {{ segment.span }};
                                    background-color: {{ segment.item.colour }};
                                    "
                    >
                        {{ segment.item.name ?: segment.item.id }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {% for segment in week.multiDaySegments %}
            {% if segment.item.is_main %}
                <div
                        class="schedule-multiday-main scheduled-block"
                        data-date="{{ segment.item.start_date | date("Y-m-d") }}"
                        data-menu="block"
                        id="{{ segment.item.id }}"
                        style="
                                --start-column: {{ segment.startColumn }};
                                --span: {{ segment.span }};
                                background-color: {{ segment.item.colour }};
                                "
                >
                    {{ segment.item.name ?: segment.item.id }}
                </div>
            {% endif %}
        {% endfor %}

        <div class="schedule-cell schedule-week-number">
            {{ week.weekNumber }}
        </div>

        <div class="schedule-cell schedule-block-week">
            B{{ week.blockWeek ?? '' }}
        </div>

        {% for day in week.days %}
            <div
                    class="schedule-cell {% if day.items|length == 0 %} schedule-day {% endif %}schedule-day-{{ loop.index }}{% if loop.first or loop.last %} schedule-edge-day{% endif %}"
                    data-date="{{ day.date|date('Y-m-d') }}"
            >
                {% if loop.first or loop.last %}
                    {{ day.key }}
                {% else %}
                    {% include 'components/schedule_day.html.twig' with {
                        day: day.items
                    } %}
                {% endif %}
            </div>
        {% endfor %}

    </div>
{% endfor %}
